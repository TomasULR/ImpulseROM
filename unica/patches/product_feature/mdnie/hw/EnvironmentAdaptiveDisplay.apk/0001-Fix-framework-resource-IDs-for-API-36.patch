index 377fda27da..d5438c6610 100644
--- a/smali/com/samsung/android/sead/EadFlickerController.smali
+++ b/smali/com/samsung/android/sead/EadFlickerController.smali
@@ -876,7 +876,7 @@
 
     move-result-object v0
 
-    const v1, 0x1070054
+    const v1, 0x107005d
 
     invoke-virtual {v0, v1}, Landroid/content/res/Resources;->getIntArray(I)[I
 
@@ -888,7 +888,7 @@
 
     move-result-object v1
 
-    const v2, 0x1070058
+    const v2, 0x1070061
 
     invoke-virtual {v1, v2}, Landroid/content/res/Resources;->getIntArray(I)[I
 
@@ -900,7 +900,7 @@
 
